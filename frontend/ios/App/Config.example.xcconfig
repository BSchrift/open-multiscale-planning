// Copy to Config.local.xcconfig.

// Your team id, from Xcode's Accounts settings. A free personal team works while MULTISCALE_EXTENSIONS is NO.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// A free team needs an id nobody else has registered.
// MULTISCALE_BUNDLE_ID = com.example.multiscale

// Once you have a paid membership: adds the share sheet and the Control Center widget.
// MULTISCALE_EXTENSIONS = YES
