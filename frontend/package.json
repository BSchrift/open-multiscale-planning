{
  "name": "multiscale",
  "productName": "Multiscale",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first personal task manager that plans across goals, stretches, weeks and days.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "scripts/build-lock.sh vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:electron": "scripts/build-lock.sh sh -c 'vite build && node scripts/electron-compile.mjs && playwright test -c electron/playwright.config.ts \"$@\"' e2e",
    "test:electron-runtime": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config electron/vitest.electron.config.ts",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "scripts/build-lock.sh node scripts/electron-build.mjs",
    "ios:sync": "scripts/build-lock.sh node scripts/ios-sync.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rrule": "^2.8.1",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
