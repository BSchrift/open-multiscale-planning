{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "merge_queue",
      "parameters": {
        "merge_method": "MERGE",
        "grouping_strategy": "ALLGREEN",
        "max_entries_to_build": 3,
        "min_entries_to_merge": 1,
        "max_entries_to_merge": 5,
        "min_entries_to_merge_wait_minutes": 0,
        "check_response_timeout_minutes": 60
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "secret-scan", "integration_id": 15368 },
          { "context": "cla", "integration_id": 15368 },
          { "context": "frontend", "integration_id": 15368 },
          { "context": "backend", "integration_id": 15368 },
          { "context": "infrastructure", "integration_id": 15368 },
          { "context": "local-suite", "integration_id": 15368 },
          { "context": "e2e-stack", "integration_id": 15368 },
          { "context": "e2e-browser", "integration_id": 15368 },
          { "context": "e2e-electron", "integration_id": 15368 },
          { "context": "e2e-compat", "integration_id": 15368 }
        ]
      }
    }
  ]
}
