<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What a Developer ID build of the Mac app may do under the hardened runtime, for the app and its helpers alike.
     V8 compiles JavaScript as it runs, which needs JIT. Nothing else: every library in the app is signed by the same
     team, so library validation stays on and the app loads no code from elsewhere. Ad hoc builds have no team, so they
     keep electron-builder's defaults, which turn it off. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
