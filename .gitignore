# Dependencies and build output
node_modules/
dist/
dist-electron/
release/
build/
*.tsbuildinfo
coverage/
playwright-report/
test-results/
blob-report/

# Go
backend/bin/
backend/dist/
*.test
*.out

# CDK
infrastructure/cdk.out/
infrastructure/cdk.context.json

# Secrets and per-deployment config: only the .example files are committed
.env
.env.*
!.env.example
*.local
*.local.*
*.pem
*.p8
*.p12
*.mobileprovision
config.json
config.*.json
!*.example.json
deploy.config.*
!deploy.config.example.*
infrastructure/config.*
!infrastructure/config.example.*
# Replaced by the config folder, but an old checkout may still hold real values here.
infrastructure/config/
**/integration/config/*.json
!**/integration/config/*.example.json
!**/integration/config/local.json
# The default config dir: per-environment YAML, deploy records and stack outputs stay local
/config/*.yaml
!/config/*.example.yaml
# The app's own settings, which are public: see docs/config.md.
!/config/protocol.yaml
!/config/env/
/config/*.deployed
/config/*.outputs.json
frontend/app.config.*

# Xcode user data and build products
xcuserdata/
*.xcuserstate
*.xccheckout
DerivedData/
frontend/ios/App/Pods/
frontend/ios/App/App/public/
frontend/ios/App/build/
frontend/ios/DerivedData/
frontend/.build.lock

# Local databases
*.sqlite
*.sqlite3
*.db

# OS and editors
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code: the skills are shared; worktrees and personal settings are not.
.claude/worktrees/
.claude/settings.local.json
